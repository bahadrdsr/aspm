{
  "apiVersion": "aspm/v1alpha1",
  "kind": "InstallationDefaults",
  "status": "contract-only",
  "description": "Reviewable resolved examples, not runnable releases. The .invalid address, namespace/context and 0.0.0-dev.1 version are placeholders. The future installer must resolve safe access and the real signed release before approval.",
  "retentionProfiles": {
    "small": {
      "policyRef": "docs\\contracts\\v1alpha1\\capacity.profiles.json",
      "policyIds": ["hot-history", "archived-evidence", "raw-report", "audit"]
    }
  },
  "profiles": [
    {
      "id": "linux-small",
      "configuration": {
        "apiVersion": "aspm/v1alpha1",
        "kind": "Installation",
        "release": { "version": "0.0.0-dev.1", "artifactSource": "installer-bundle" },
        "target": { "kind": "linux", "host": "localhost" },
        "access": { "exposure": "loopback", "tlsMode": "internal-ca", "baseURL": "https://aspm.example.invalid", "publicExposureApproved": false },
        "bootstrap": { "method": "one-time-enrollment", "secretRef": { "kind": "generated", "name": "aspm-enrollment" } },
        "postgres": {
          "mode": "managed", "engine": "postgresql", "image": "postgres:18.6-alpine",
          "persistent": true, "publicAccess": false, "volumeName": "aspm-postgres",
          "credentialRef": { "kind": "generated", "name": "aspm-postgres" }
        },
        "objectStore": {
          "mode": "managed", "engine": "seaweedfs-community", "api": "s3",
          "persistent": true, "publicAccess": false, "volumeName": "aspm-evidence", "bucket": "aspm-evidence",
          "credentialRef": { "kind": "generated", "name": "aspm-evidence" },
          "image": { "version": "4.47", "digest": "sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882" },
          "seaweedfs": {
            "masterTelemetry": false, "adminUI": false, "webdav": false, "icebergPort": 0, "lancePort": 0,
            "publishedAPIs": ["s3"], "managementExposure": "internal-only"
          }
        },
        "ai": { "mode": "disabled", "profiles": [], "fallbackProfiles": [], "hostedProcessingApproved": false },
        "proof": { "enabled": false, "executionPolicy": "controlled-fixtures-only" },
        "services": {
          "core-api": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ingestion-parser": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ingestion-reconciler": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "background-worker": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ai-service": { "replicas": 0, "dbConnectionsPerReplica": 0 },
          "proof-service": { "replicas": 0, "dbConnectionsPerReplica": 0 }
        },
        "databaseConnectionBudget": { "max": 80, "reservedMaintenance": 10 },
        "artifacts": { "mode": "online", "signatureRequired": true, "outboundRetrievalRequiresApproval": true },
        "retentionProfile": "small"
      }
    },
    {
      "id": "kubernetes-small",
      "configuration": {
        "apiVersion": "aspm/v1alpha1",
        "kind": "Installation",
        "release": { "version": "0.0.0-dev.1", "artifactSource": "installer-bundle" },
        "target": { "kind": "kubernetes", "context": "synthetic-context", "namespace": "aspm" },
        "access": { "exposure": "private", "tlsMode": "internal-ca", "baseURL": "https://aspm.example.invalid", "publicExposureApproved": false },
        "bootstrap": { "method": "one-time-enrollment", "secretRef": { "kind": "generated", "name": "aspm-enrollment" } },
        "postgres": {
          "mode": "managed", "engine": "postgresql", "image": "postgres:18.6-alpine",
          "persistent": true, "publicAccess": false, "volumeName": "aspm-postgres",
          "credentialRef": { "kind": "generated", "name": "aspm-postgres" }
        },
        "objectStore": {
          "mode": "managed", "engine": "seaweedfs-community", "api": "s3",
          "persistent": true, "publicAccess": false, "volumeName": "aspm-evidence", "bucket": "aspm-evidence",
          "credentialRef": { "kind": "generated", "name": "aspm-evidence" },
          "image": { "version": "4.47", "digest": "sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882" },
          "seaweedfs": {
            "masterTelemetry": false, "adminUI": false, "webdav": false, "icebergPort": 0, "lancePort": 0,
            "publishedAPIs": ["s3"], "managementExposure": "internal-only"
          }
        },
        "ai": { "mode": "disabled", "profiles": [], "fallbackProfiles": [], "hostedProcessingApproved": false },
        "proof": { "enabled": false, "executionPolicy": "controlled-fixtures-only" },
        "services": {
          "core-api": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ingestion-parser": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ingestion-reconciler": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "background-worker": { "replicas": 1, "dbConnectionsPerReplica": 10 },
          "ai-service": { "replicas": 0, "dbConnectionsPerReplica": 0 },
          "proof-service": { "replicas": 0, "dbConnectionsPerReplica": 0 }
        },
        "databaseConnectionBudget": { "max": 80, "reservedMaintenance": 10 },
        "artifacts": { "mode": "online", "signatureRequired": true, "outboundRetrievalRequiresApproval": true },
        "retentionProfile": "small"
      }
    }
  ]
}
