      "remediation": "Review the synthetic configuration and record a scoped retest.",
      "unmapped": { "vendorNote": "Preserve this unmapped synthetic note." }
    },
    "normalizationExplanation": "This deliberate high-to-medium fixture tests preservation of source meaning; it is not a scoring recommendation. The original exact UTF-8 bytes and source fields remain available independently of the derived severity."
  },
