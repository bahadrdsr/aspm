[Unit]
Description=ASPM opt-in deterministic verification worker
After=network-online.target aspm-postgres.service
Wants=network-online.target

[Container]
Image=localhost/aspm:0.1.0-dev
ContainerName=aspm-verification
Network=aspm.network
EnvironmentFile=/etc/aspm/verification.env
Exec=/app/bin/verification-worker
ReadOnly=true
Tmpfs=/tmp:rw,size=64m
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
TimeoutStartSec=180
