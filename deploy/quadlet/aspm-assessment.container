[Unit]
Description=ASPM opt-in assessment worker
After=network-online.target aspm-postgres.service
Wants=network-online.target

[Container]
Image=localhost/aspm:0.1.0-dev
ContainerName=aspm-assessment
Network=aspm.network
EnvironmentFile=/etc/aspm/assessment.env
Exec=/app/bin/assessment-worker
ReadOnly=true
Tmpfs=/tmp:rw,size=256m
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
TimeoutStartSec=180
