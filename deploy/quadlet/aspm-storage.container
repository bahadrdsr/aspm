[Unit]
Description=ASPM private shared evidence storage

[Container]
Image=docker.io/chrislusf/seaweedfs:4.47
ContainerName=aspm-storage
Network=aspm.network
Volume=aspm-storage.volume:/data
Secret=aspm-storage-policy,type=mount,target=/etc/seaweed/s3.json,uid=1000,gid=1000,mode=0400
Exec=mini -dir=/data -s3.config=/etc/seaweed/s3.json -bucket=aspm-evidence -master.telemetry=false -admin.ui=false -webdav=false -s3.port.iceberg=0 -s3.port.lance=0 -s3.iam=false -s3.allowDeleteBucketNotEmpty=false -filer.disableDirListing=true -filer.exposeDirectoryData=false

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
